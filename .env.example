# Copy to .env and adapt these illustrative absolute paths.
# Existing process environment variables take precedence (override=False).
DJANGO_DEBUG=false
DJANGO_LOCAL_HTTPS=true
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_PRIVATE_CATALOG_ROOT='C:\DjangoPrivado\catalogo'
DJANGO_RECEIPTS_KEY_ID=rsa-demo-2026
DJANGO_RECEIPTS_PRIVATE_KEY_PATH='C:\DjangoPrivado\rsa-demo-2026\privada.pem'
DJANGO_RECEIPTS_PUBLIC_KEYS_DIR='C:\DjangoPrivado\rsa-demo-2026\publicas'

# Binary DPAPI CurrentUser blobs containing UTF-8 text, not SecureString exports.
# The launcher decrypts them using the Windows account that protected them.
DJANGO_SECRET_KEY_DPAPI_PATH='C:\DjangoPrivado\django-secret.dpapi'
DJANGO_RECEIPTS_PASSWORD_DPAPI_PATH='C:\DjangoPrivado\rsa-demo-2026\password.dpapi'

# Never store DJANGO_SECRET_KEY or DJANGO_RECEIPTS_PRIVATE_KEY_PASSWORD here.
# Keep private keys and catalog files outside the project and web roots.
# Public verification keys may be distributed; do not ignore all *.pem files.
# Start Caddy separately with the unchanged Caddyfile; use https://localhost:8443.
# Iniciar-Seguro.ps1 -Check validates configuration without starting a server.
